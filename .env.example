# Dossier de la base SQLite et des fichiers envoyés
DATA_DIR=./data

# Taille maximale d'un fichier joint, en Mo
MAX_FILE_MB=25

# --- Modules : les autres outils de la suite ---
# Donne l'adresse d'un outil pour le brancher : il apparaît dans « Modules » et dans la barre de gauche.
# Sans adresse, il reste affiché « Bientôt ».
CAIRN_URL=
METRICOVE_URL=
ALFRED_URL=
NINO_URL=

# --- Connexion unique : entrer dans un outil avec son compte Lamio ---
# Un secret par outil, de 32 caractères au moins (openssl rand -base64 32).
# Le même secret va dans l'outil, sous le nom LAMIO_SSO_SECRET, avec LAMIO_URL (l'adresse de Lamio).
CAIRN_SSO_SECRET=
METRICOVE_SSO_SECRET=
ALFRED_SSO_SECRET=
NINO_SSO_SECRET=

# À mettre à "true" seulement pour tester l'image de production en http (sans HTTPS, le cookie de session est refusé).
INSECURE_COOKIE=
